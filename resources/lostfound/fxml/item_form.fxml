<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="lostfound.controller.ItemFormController"
      alignment="CENTER"
      spacing="15.0"
      style="-fx-padding: 20.0;">

    <Label text="Add / Edit Item" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <GridPane hgap="12.0" vgap="10.0">
        <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="320.0" />

        <Label text="Type:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <ComboBox fx:id="typeCombo" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="320.0" promptText="Select type" />

        <Label text="Description:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <TextArea fx:id="descField" GridPane.rowIndex="2" GridPane.columnIndex="1" prefRowCount="5" prefWidth="320.0" />
    </GridPane>

    <HBox spacing="15.0" alignment="CENTER_RIGHT">
        <Button text="Save" onAction="#handleSave" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
        <Button text="Cancel" onAction="#handleCancel" />
    </HBox>

</VBox>