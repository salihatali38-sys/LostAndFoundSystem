<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="lostfound.controller.ChatWindowController"
           dividerPositions="0.3"
           orientation="HORIZONTAL"
           style="-fx-padding: 10;">

    <!-- Left: Conversation List -->
    <VBox spacing="10">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <Label text="Conversations" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <ListView fx:id="conversationList" prefWidth="250"/>
    </VBox>

    <!-- Right: Selected Chat -->
    <VBox spacing="10" fx:id="chatPane" visible="false">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <Label fx:id="chatHeader" text="Select a conversation" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <ListView fx:id="messageList" prefHeight="400" style="-fx-background-color: #f0f0f0;"/>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <TextArea fx:id="messageInput" promptText="Type your message..." prefRowCount="3" wrapText="true" HBox.hgrow="ALWAYS"/>
            <Button text="Send" onAction="#handleSend" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        </HBox>
    </VBox>
</SplitPane>
